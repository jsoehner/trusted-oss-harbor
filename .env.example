# ==============================================================================
# Trusted OSS Supply Chain Platform (Harbor + ClamAV + Gatekeeper) Configuration
# ==============================================================================

# Persistent storage root on the local Linux host (bind-mounted by all services)
# Phase 1 (Active): Home directory persistent store
# Phase 2 (Roadmap): External TrueNAS iSCSI block mount (e.g., /mnt/truenas-iscsi-oss)
OSS_DATA_ROOT=/home/jsoehner/trusted-oss-data

# TrueNAS iSCSI Block Storage Roadmap Settings (used by scripts/setup_truenas_iscsi_mount.sh)
TRUENAS_ISCSI_PORTAL=192.168.1.50:3260
TRUENAS_ISCSI_IQN=iqn.2005-10.org.freenas.ctl:trusted-oss-harbor-lun0
TRUENAS_ISCSI_MOUNTPOINT=/mnt/truenas-iscsi-oss

# Public FQDN routed via pfSense HAProxy (mTLS + GitHub CIDR allowlist)
HARBOR_DOMAIN=oss.example.com

# Harbor Admin & Database Credentials (override in .env before running make bootstrap)
HARBOR_ADMIN_PASSWORD=ChangeMe_HarborAdmin_2026!
HARBOR_DB_PASSWORD=ChangeMe_Postgres_2026!

# Harbor Installer Version
HARBOR_VERSION=v2.12.2

# Security Policy Thresholds
CVSS_FAIL_THRESHOLD=7.0
AUTO_PROMOTE_CLEAN_ARTIFACTS=true
ALLOW_UPSTREAM_FALLBACK_ON_MISS=true

# Signing Identity Configuration
GPG_KEY_NAME="Trusted OSS Supply Chain Authority"
GPG_KEY_EMAIL="oss-signing@example.com"
GPG_PASSPHRASE=""
COSIGN_PASSWORD=""

# Upstream Repositories (queried only by the Quarantine Gatekeeper)
UPSTREAM_MAVEN_URL=https://repo.maven.apache.org/maven2
UPSTREAM_PYPI_SIMPLE_URL=https://pypi.org/simple
NVD_CACHE_RELEASE_URL=https://github.com/jsoehner/nvd-cache/releases/download/latest-nvd-data/odc.mv.db.zip

# Gatekeeper API Token for Administrative / CI Promotion Endpoints (REQUIRED: replace before starting)
GATEKEEPER_ADMIN_TOKEN=ChangeMe_GatekeeperToken_2026!
PROVENANCE_HMAC_KEY=
TRIVY_REQUIRED=false
ALLOW_SIMULATED_CVSS=false
MAX_ARTIFACT_BYTES=262144000
